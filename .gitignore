# Never commit real data. The tool reads statements and writes reports; both are confidential.
*.pdf
*.xlsx
*.xlsm
*.csv
*.tsv
*.ods
*.log
outputs/

# The live config names real mail folders and real column headers. Only the example is tracked.
config.yaml
config.*.yaml
!config.example.yaml

# The demo is generated by examples/demo/build_demo.py, so it is never committed --
# the generator is the source of truth, not its output.
/demo/

# Synthetic test fixtures are generated at run time, never stored.
tests/fixtures/generated/

__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
.venv/
venv/
.idea/
.vscode/
